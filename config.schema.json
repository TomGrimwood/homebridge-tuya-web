{
  "pluginAlias": "TuyaWebPlatform",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Homebridge plugin for Tuya/Smart Life devices. Uses the same API as the Home Assistant Smart Life integration — just enter your User Code and scan a QR code.",
  "footerDisplay": "After entering your User Code, restart Homebridge and check the logs for the QR code to scan with your Smart Life app.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "TuyaWebPlatform",
        "description": "You shouldn't need to change this."
      },
      "options": {
        "title": "",
        "type": "object",
        "required": true,
        "properties": {
          "localOnly": {
            "title": "LAN-only mode (no cloud access)",
            "type": "boolean",
            "default": false,
            "description": "When enabled, the plugin will NOT contact any Tuya cloud service. Requires per-device local_key (16-char AES key) and IP, which must be obtained once via Tuya cloud or `tuya-cli wizard`. Strongly recommended for privacy / reliability — the Tuya account can be safely deleted once each device's local_key has been recorded."
          },
          "userCode": {
            "title": "User Code (cloud mode only)",
            "type": "string",
            "required": false,
            "description": "Your Smart Life User Code (cloud mode only). In the Smart Life app: Me → Settings → Account and Security → User Code. Leave empty if localOnly is enabled."
          },
          "pollingInterval": {
            "title": "Polling Interval",
            "type": "number",
            "description": "The frequency in seconds that the plugin polls for device updates. Can be left empty to only fetch on request. In cloud mode, must be 600 or larger to avoid rate limits.",
            "required": false,
            "minimum": 0
          }
        }
      },
      "devices": {
        "title": "LAN Devices",
        "description": "Required when LAN-only mode is enabled. One entry per device on your network.",
        "type": "array",
        "items": {
          "title": "LAN device",
          "type": "object",
          "properties": {
            "id": {
              "title": "Device ID (virtual id)",
              "type": "string",
              "required": true,
              "description": "Tuya virtual device id, e.g. eb119c7e19b2e1f2a6gdmp"
            },
            "local_key": {
              "title": "Local Key",
              "type": "string",
              "required": true,
              "description": "16-character AES key. Get it from the Tuya cloud or `tuya-cli wizard`."
            },
            "ip": {
              "title": "Device IP",
              "type": "string",
              "required": false,
              "description": "LAN IP of the device. Strongly recommended."
            },
            "name": {
              "title": "Display name",
              "type": "string",
              "required": false
            },
            "version": {
              "title": "Protocol version",
              "type": "string",
              "default": "3.3",
              "required": false,
              "description": "Tuya protocol version. 3.3 covers most devices; some newer firmware uses 3.4 or 3.5."
            },
            "device_type": {
              "title": "Device type",
              "type": "string",
              "required": false,
              "default": "light",
              "oneOf": [
                { "title": "Light", "enum": ["light"] },
                { "title": "Dimmer", "enum": ["dimmer"] },
                { "title": "Switch", "enum": ["switch"] },
                { "title": "Outlet", "enum": ["outlet"] },
                { "title": "Fan", "enum": ["fan"] },
                { "title": "Cover", "enum": ["cover"] },
                { "title": "Window", "enum": ["window"] },
                { "title": "Garage Door", "enum": ["garage"] },
                { "title": "Thermostat", "enum": ["climate"] },
                { "title": "Temperature Sensor", "enum": ["temperature_sensor"] }
              ]
            }
          }
        }
      },
      "defaults": {
        "title": "Device Settings",
        "description": "Here you can configure settings for each of your devices.",
        "type": "array",
        "items": {
          "title": "Overwrite",
          "type": "object",
          "properties": {
            "id": {
              "title": "Device name or id",
              "type": "string",
              "description": "Device ID shown in debug logs during plugin boot.",
              "required": true
            },
            "device_type": {
              "title": "Device type",
              "type": "string",
              "default": "form",
              "description": "The type that you want the device to be exposed as",
              "oneOf": [
                { "title": "Dimmer", "enum": ["dimmer"] },
                { "title": "Fan", "enum": ["fan"] },
                { "title": "Garage Door", "enum": ["garage"] },
                { "title": "Light", "enum": ["light"] },
                { "title": "Outlet", "enum": ["outlet"] },
                { "title": "Scene", "enum": ["scene"] },
                { "title": "Switch", "enum": ["switch"] },
                { "title": "Temperature Sensor", "enum": ["temperature_sensor"] },
                { "title": "Thermostat", "enum": ["climate"] },
                { "title": "Window Cover", "enum": ["cover"] },
                { "title": "Window", "enum": ["window"] }
              ],
              "required": true
            },
            "min_temper": {
              "title": "Minimal Temperature",
              "type": "string",
              "pattern": "^-?\\d+(?:\\.[05])?$",
              "placeholder": "0.0",
              "required": false
            },
            "max_temper": {
              "title": "Maximal Temperature",
              "type": "string",
              "pattern": "^-?\\d+(?:\\.[05])?$",
              "placeholder": "35.0",
              "required": false
            },
            "min_brightness": {
              "title": "Minimal Brightness",
              "type": "string",
              "pattern": "^-?\\d+$",
              "required": false
            },
            "max_brightness": {
              "title": "Maximal Brightness",
              "type": "string",
              "pattern": "^-?\\d+$",
              "required": false
            },
            "min_kelvin": {
              "title": "Minimal Kelvin",
              "type": "string",
              "pattern": "^-?\\d+$",
              "required": false
            },
            "max_kelvin": {
              "title": "Maximal Kelvin",
              "type": "string",
              "pattern": "^-?\\d+$",
              "required": false
            },
            "current_temperature_factor": {
              "title": "Temperature Factor",
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$",
              "placeholder": "I.e. 0.1",
              "required": false
            },
            "target_temperature_factor": {
              "title": "Target Temperature Factor",
              "type": "string",
              "pattern": "^\\d+(?:\\.\\d+)?$",
              "placeholder": "I.e. 0.1",
              "required": false
            },
            "cover_characteristics": {
              "title": "Features",
              "type": "array",
              "uniqueItems": true,
              "items": { "title": "Feature", "type": "string", "enum": ["Stop"] }
            },
            "dimmer_characteristics": {
              "title": "Features",
              "type": "array",
              "uniqueItems": true,
              "items": { "title": "Feature", "type": "string", "enum": ["Brightness"] }
            },
            "fan_characteristics": {
              "title": "Features",
              "type": "array",
              "uniqueItems": true,
              "items": { "title": "Feature", "type": "string", "enum": ["Speed"] }
            },
            "light_characteristics": {
              "title": "Features",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "title": "Feature",
                "type": "string",
                "enum": ["Brightness", "Color", "Color Temperature"]
              }
            }
          }
        }
      },
      "scenes": {
        "title": "Expose Tuya scenes to Homekit",
        "type": "boolean",
        "required": true,
        "default": false
      },
      "scenesWhitelist": {
        "title": "Tuya scenes to expose to Homekit",
        "type": "array",
        "required": false,
        "items": {
          "title": "Scene name or id",
          "type": "string",
          "required": true
        }
      },
      "hiddenAccessories": {
        "title": "Accessories to hide from Homekit",
        "type": "array",
        "required": false,
        "items": {
          "title": "Accessory name or id",
          "type": "string",
          "required": true
        }
      }
    }
  },
  "layout": [
    "options.localOnly",
    {
      "key": "options.userCode",
      "condition": { "functionBody": "return !model.options.localOnly" }
    },
    {
      "type": "fieldset",
      "title": "LAN Devices",
      "expandable": true,
      "expanded": true,
      "condition": { "functionBody": "return model.options.localOnly" },
      "items": [
        {
          "type": "array",
          "items": [
            { "key": "devices[].name" },
            { "key": "devices[].id" },
            { "key": "devices[].local_key" },
            { "key": "devices[].ip" },
            { "key": "devices[].device_type" },
            { "key": "devices[].version" }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Device Settings",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "type": "array",
          "items": [
            { "key": "defaults[].id" },
            { "key": "defaults[].device_type" },
            {
              "key": "defaults[].cover_characteristics",
              "condition": {
                "functionBody": "return (['cover', 'window'].includes(model.defaults[arrayIndices].device_type))"
              }
            },
            {
              "key": "defaults[].dimmer_characteristics",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].device_type == 'dimmer')"
              }
            },
            {
              "key": "defaults[].fan_characteristics",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].device_type == 'fan')"
              }
            },
            {
              "key": "defaults[].light_characteristics",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].device_type == 'light')"
              }
            },
            {
              "key": "defaults[].min_temper",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].device_type == 'climate')"
              }
            },
            {
              "key": "defaults[].max_temper",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].device_type == 'climate')"
              }
            },
            {
              "key": "defaults[].min_brightness",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].light_characteristics?.includes('Brightness') || model.defaults[arrayIndices].dimmer_characteristics?.includes('Brightness'))"
              }
            },
            {
              "key": "defaults[].max_brightness",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].light_characteristics?.includes('Brightness') || model.defaults[arrayIndices].dimmer_characteristics?.includes('Brightness'))"
              }
            },
            {
              "key": "defaults[].min_kelvin",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].light_characteristics?.includes('Color Temperature'))"
              }
            },
            {
              "key": "defaults[].max_kelvin",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].light_characteristics?.includes('Color Temperature'))"
              }
            },
            {
              "key": "defaults[].current_temperature_factor",
              "condition": {
                "functionBody": "return (['climate', 'temperature_sensor'].includes(model.defaults[arrayIndices].device_type))"
              }
            },
            {
              "key": "defaults[].target_temperature_factor",
              "condition": {
                "functionBody": "return (model.defaults[arrayIndices].device_type == 'climate')"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Optional Settings",
      "expandable": true,
      "expanded": false,
      "items": ["options.pollingInterval"]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "expanded": false,
      "items": [
        {
          "title": "Hidden accessories",
          "type": "array",
          "description": "Enter the identifiers of accessories that you wish not to expose to HomeKit.",
          "items": [{ "key": "hiddenAccessories[]", "required": true }]
        },
        {
          "type": "fieldset",
          "title": "Scenes",
          "items": [
            "scenes",
            {
              "title": "Whitelisted scene",
              "type": "array",
              "description": "Enter the scenes that you wish to expose to Homekit, when left empty <b>all</b> scenes will be exposed.",
              "condition": { "functionBody": "return (model.scenes)" },
              "items": [{ "key": "scenesWhitelist[]", "required": true }]
            }
          ]
        }
      ]
    }
  ]
}
